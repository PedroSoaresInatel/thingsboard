{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ui-ngx": {
      "root": "ui-ngx",
      "framework": "angular",
      "installCommand": "yarn install --non-interactive --network-timeout 100000",
      "buildCommand": "yarn build:prod",
      "outputDirectory": "target/generated-resources/public",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://seu-backend.invalid/api/$1" },
    { "source": "/static/rulenode/(.*)", "destination": "https://seu-backend.invalid/static/rulenode/$1" },
    { "source": "/static/widgets/(.*)", "destination": "https://seu-backend.invalid/static/widgets/$1" },
    { "source": "/oauth2/(.*)", "destination": "https://seu-backend.invalid/oauth2/$1" },
    { "source": "/login/oauth2/(.*)", "destination": "https://seu-backend.invalid/login/oauth2/$1" },
    { "source": "/(.*)", "destination": { "service": "ui-ngx" } }
  ]
}
