# Copie para .env e ajuste. O arquivo .env não é versionado (está no .gitignore).

# Senha do PostgreSQL. Obrigatória. Defina antes da primeira instalação: ela é gravada no volume do banco
# e não muda se você apenas editar este arquivo depois.
POSTGRES_PASSWORD=

# Versão da imagem thingsboard/tb-node.
TB_VERSION=4.4.0.2

# Endereço em que as portas são publicadas.
# 127.0.0.1 = só na própria máquina. 0.0.0.0 = acessível pela rede.
TB_BIND_ADDRESS=127.0.0.1
TB_HTTP_PORT=8080
TB_MQTT_PORT=1883

# Licença: preencha a chave OU ative o modo sem chave. Se os dois ficarem vazios/false,
# a interface abre pedindo a chave no assistente de configuração.
TB_LICENSE_SECRET=
NON_PRODUCTION_USE=false

# Memória do Java. O padrão serve para máquinas com 4 GB de RAM.
TB_JAVA_OPTS=-Xms512m -Xmx1536m
